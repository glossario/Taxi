# Copie para .env (o .env nunca vai para o GitHub) e ajuste.

# Senha do banco PostgreSQL (invente uma forte; só o container usa)
DB_PASSWORD=troque-esta-senha

# Chave que assina o cookie de login (gere uma: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=troque-esta-chave

# Porta no seu computador e endereço que vai nos links dos e-mails.
# Para o gestor abrir o link de outro computador da rede, use o IP da sua máquina, ex.: http://192.168.0.50:8080
PORTA=8080
APP_URL=http://localhost:8080

# Arquivo com usuário (linha 1) e senha (linha 2) do noreply — fora do repositório
NOREPLY_FILE=../../noreply.txt
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# Desligue (0) para só registrar os e-mails no banco, sem enviar
SMTP_ENVIAR=1

# AD local (LDAP). Ex.: ldap://dc01.natulab.local  ou  ldaps://dc01.natulab.local
LDAP_SERVER=
# Domínio usado no login (usuario@DOMINIO) e base de busca
LDAP_DOMAIN=natulab.com.br
LDAP_BASE_DN=DC=natulab,DC=local

# Perfis: e-mails separados por vírgula (depois pode virar grupo do AD)
PERFIL_FACILITIES=
PERFIL_TI=

# SÓ PARA TESTE: com LDAP_SERVER vazio e LOGIN_TESTE=1, entra com usuários fictícios (sem senha).
LOGIN_TESTE=1

# Testes com usuários reais: todo e-mail vai para este endereço (vazio = envio normal)
EMAIL_REDIRECIONAR=
